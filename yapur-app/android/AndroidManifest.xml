<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ar.net.yapur.gestion"
    android:versionCode="__VERSION_CODE__"
    android:versionName="__VERSION_NAME__">
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Solo para guardar copias y listados en Descargas en Android 9 o anterior; en Android 10+ no hace falta ningún permiso -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <!-- Ubicación, para dos cosas:
         1) cuando el técnico toca «Usar mi ubicación actual» para cargar las coordenadas de la casa de un cliente;
         2) solo para los técnicos que aceptaron el aviso y solo dentro del horario laboral: un servicio en primer plano, con una notificación
            «ubicación activa» a la vista, le manda su posición a la oficina aunque la pantalla esté apagada o la app cerrada, para que el
            ingreso y el fin de la jornada se anoten solos. Fuera del horario no se toma ni se guarda nada.
         ACCESS_BACKGROUND_LOCATION («Permitir todo el tiempo») hace falta para que, si Android cierra el servicio o se reinicia el celular,
         pueda volver a leer la posición sin que el técnico abra la app (Android 12+ no deja leerla desde un servicio arrancado en segundo plano). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Para que el servicio de ubicación vuelva solo al prender el celular (y al actualizar la app), sin abrirla -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Android 13+: para poder mostrar la notificación «ubicación activa» -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Para que la app pueda pedirle al técnico, con el cuadro del propio Android, que la deje «sin restricción de batería»:
         sin eso, muchos celulares (Xiaomi, Samsung, Motorola…) duermen o cierran la app con la pantalla apagada y la ubicación se corta. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-feature android:name="android.hardware.location" android:required="false"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name="ar.net.yapur.gestion.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="keyboardHidden|keyboard|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name="ar.net.yapur.gestion.UbicacionService"
            android:exported="false"
            android:foregroundServiceType="location"/>
        <!-- La foto del comprobante con la cámara: la cámara del celular guarda la foto en un archivo temporal de la app.
             No hace falta el permiso CAMERA (y NO hay que agregarlo: con el permiso declarado, Android exige concederlo antes de abrir la cámara). -->
        <provider
            android:name="ar.net.yapur.gestion.FotoProvider"
            android:authorities="ar.net.yapur.gestion.fotos"
            android:exported="false"
            android:grantUriPermissions="true"/>
        <receiver
            android:name="ar.net.yapur.gestion.UbicacionReceptor"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
